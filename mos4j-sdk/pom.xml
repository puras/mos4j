<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>net.hegq</groupId>
    <artifactId>mos4j</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>mos4j-sdk</artifactId>
  <name>MoS4J :: SDK</name>
  <description>SDK 门面：一次依赖拿到全部模块与缺省装配（交付本体；Spring starter 按需另行发布）</description>
  <dependencies>
    <dependency>
      <groupId>net.hegq</groupId>
      <artifactId>mos4j-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>net.hegq</groupId>
      <artifactId>mos4j-llm</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>net.hegq</groupId>
      <artifactId>mos4j-tool</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>net.hegq</groupId>
      <artifactId>mos4j-session</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>net.hegq</groupId>
      <artifactId>mos4j-driver</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>net.hegq</groupId>
      <artifactId>mos4j-execpath</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>net.hegq</groupId>
      <artifactId>mos4j-hook</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>net.hegq</groupId>
      <artifactId>mos4j-policy</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>net.hegq</groupId>
      <artifactId>mos4j-fs</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>net.hegq</groupId>
      <artifactId>mos4j-sandbox</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>net.hegq</groupId>
      <artifactId>mos4j-context</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <configuration>
          <ignoredUnusedDeclaredDependencies combine.children="append">
            <!-- 门面是「一次依赖拿到全部模块」：下面这些模块由门面转暴露/转装配，
                 门面自身不直接引用它们的类型（用户拿到的却是能用的），
                 所以依赖分析会报「声明了却没用」——此处显式豁免并说明理由。
                 删掉这些依赖等于让用户自己补依赖，门面的承诺就破了。
                 （core / hook / context 已在门面主代码里被直接引用，不在此列。） -->
            <ignoredUnusedDeclaredDependency>net.hegq:mos4j-execpath</ignoredUnusedDeclaredDependency>
            <ignoredUnusedDeclaredDependency>net.hegq:mos4j-policy</ignoredUnusedDeclaredDependency>
          </ignoredUnusedDeclaredDependencies>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
