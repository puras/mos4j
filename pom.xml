<?xml version="1.0" encoding="UTF-8"?>
<!--
  MoS4J — 参考 MoS 的 Java 智能体基础框架（SDK 本体；starter 按需见任务列表 §10）
  契约：docs/contract/{INVARIANTS,MECHANISMS,API}.md + fieldnames.json（冻结清单）
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>net.hegq</groupId>
  <artifactId>mos4j</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>MoS4J</name>
  <description>MoS4J: Java reimplementation of the MoS agent framework (reference semantics, SDK-first)</description>
  <url>https://github.com/puras/mos4j</url>

  <!-- 许可证：MIT（2026-11-07 用户拍板；文本见仓库根的 LICENSE） -->
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <!-- SCM：发布到 Central 时元数据校验会查这一项（仓库地址是客观事实，先写死） -->
  <scm>
    <connection>scm:git:https://github.com/puras/mos4j.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/puras/mos4j.git</developerConnection>
    <url>https://github.com/puras/mos4j</url>
  </scm>

  <modules>
    <!--
      SDK 六个模块（2026-11-08 合并）：把原先十二个细粒度模块合并成六层。
      合并的判据是「依赖方向」：下层不得知道上层，上层按需引用下层。
      模块变粗不意味着边界变松——边界改由包前缀规则守护（BoundaryRulesTest 的包级门）。
    -->
    <module>mos4j-core</module>
    <module>mos4j-model</module>
    <module>mos4j-runtime</module>
    <module>mos4j-tool</module>
    <module>mos4j-session</module>
    <module>mos4j-agent</module>
    <!-- mos4j-spring-boot-starter：按需（见 docs/mos4j-tasks.md §10），不进默认构建 -->
  </modules>

  <properties>
    <!-- 编译与运行时目标：JDK 25 -->
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- 运行时依赖版本（依赖纪律 I7：SDK 只允许 Jackson 家族 / RE2J / JDK） -->
    <!-- Jackson 3：databind/core 换坐标与包名（tools.jackson.*），但注解构件仍是
         com.fasterxml.jackson.core 的 2.x 线——注解不随 databind 大版本走，单独钉版本。 -->
    <jackson.version>3.2.4</jackson.version>
    <jackson.annotations.version>2.22</jackson.annotations.version>
    <!-- YAML 前置（技能 frontmatter 用）：Jackson 3 的 YAML 模块传递依赖 snakeyaml-engine，
         这里集中钉版本，避免各模块各写一份。YAML 只经由 jackson-dataformat-yaml 引入，
         不直接用 snakeyaml-engine 的 API（那是实现细节）。 -->
    <snakeyaml.version>3.0.1</snakeyaml.version>
    <re2j.version>1.7</re2j.version>

    <!-- 测试依赖版本 -->
    <junit.version>5.11.4</junit.version>

    <!-- Spring Boot 版本（只供按需模块 mos4j-spring-boot-starter 使用；
         SDK 六模块不依赖 Spring——依赖纪律 I7） -->
    <spring-boot.version>3.5.16</spring-boot.version>

    <!-- 官方 MCP Java SDK 版本（mos4j-tool 用；optional，不传递给下游宿主）。
         2.1.0 = 当前最新稳定版；2.2.0-M2 是里程碑版，不进默认路径。
         协议层不手写（Go 参考实现同款决策：2026-07-28 规范废弃了 initialize/roots/sampling，
         手写协议层要同时正确跑两代初始化流程）。 -->
    <mcp.sdk.version>2.1.0</mcp.sdk.version>

    <!-- 构建插件版本 -->
    <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
    <maven.surefire.plugin.version>3.5.2</maven.surefire.plugin.version>
    <maven.enforcer.plugin.version>3.5.0</maven.enforcer.plugin.version>
    <!-- 3.7.0 / 3.8.1 的 ASM 不认 class file 69（JDK 25），analyze 会直接报错；
         3.9.0 是第一个能读 JDK 25 字节码的版本。 -->
    <maven.dependency.plugin.version>3.9.0</maven.dependency.plugin.version>

    <!--
      内部私服发布参数（2026-11-07 裁决：不发 Maven Central，改发内部私服）。
      这些属性**故意不给默认值**：未显式传入时 deploy 会带着未解析的属性名失败（fail-closed），
      而不是悄悄发到某个默认地址。仓库里不写死任何环境地址与账号。
      用法见 docs/release.md §5。
    -->
    <mos4j.distribution.releaseRepoId>internal-releases</mos4j.distribution.releaseRepoId>
    <mos4j.distribution.snapshotRepoId>internal-snapshots</mos4j.distribution.snapshotRepoId>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>tools.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>${jackson.version}</version>
      </dependency>
      <dependency>
        <!-- 注解包不迁移：Jackson 3 继续用 com.fasterxml.jackson.annotation（2.x 线） -->
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-annotations</artifactId>
        <version>${jackson.annotations.version}</version>
      </dependency>
      <dependency>
        <groupId>tools.jackson.core</groupId>
        <artifactId>jackson-core</artifactId>
        <version>${jackson.version}</version>
      </dependency>
      <!-- YAML 数据格式模块（Jackson 3）：技能 frontmatter 解析用。
           它传递引入 org.snakeyaml:snakeyaml-engine——属于依赖纪律 I7 允许的「SnakeYAML 系」。 -->
      <dependency>
        <groupId>tools.jackson.dataformat</groupId>
        <artifactId>jackson-dataformat-yaml</artifactId>
        <version>${jackson.version}</version>
      </dependency>
      <dependency>
        <groupId>org.snakeyaml</groupId>
        <artifactId>snakeyaml-engine</artifactId>
        <version>${snakeyaml.version}</version>
      </dependency>
      <dependency>
        <groupId>com.google.re2j</groupId>
        <artifactId>re2j</artifactId>
        <version>${re2j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Spring Boot BOM：只给按需的 starter 模块用（依赖管理，不是依赖） -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- 官方 MCP Java SDK（给 mos4j-tool 用；optional → 不传递给下游宿主） -->
      <dependency>
        <groupId>io.modelcontextprotocol.sdk</groupId>
        <artifactId>mcp-core</artifactId>
        <version>${mcp.sdk.version}</version>
      </dependency>
      <dependency>
        <groupId>io.modelcontextprotocol.sdk</groupId>
        <artifactId>mcp-json-jackson3</artifactId>
        <version>${mcp.sdk.version}</version>
      </dependency>
      <!-- 模块间（compile 期互相可见，运行时同 groupId 合并发布） -->
      <dependency>
        <groupId>net.hegq</groupId>
        <artifactId>mos4j-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>net.hegq</groupId>
        <artifactId>mos4j-model</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>net.hegq</groupId>
        <artifactId>mos4j-runtime</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>net.hegq</groupId>
        <artifactId>mos4j-tool</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>net.hegq</groupId>
        <artifactId>mos4j-session</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>net.hegq</groupId>
        <artifactId>mos4j-agent</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- 全模块测试基座 -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- 显式声明 api：aggregator 只是为了带 engine，analyze 看不到直接引用 -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven.compiler.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven.surefire.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${maven.enforcer.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>${maven.dependency.plugin.version}</version>
          <configuration>
            <!-- aggregator 只为带 engine，不算“声明了却没用” -->
            <ignoredUnusedDeclaredDependencies>
              <ignoredUnusedDeclaredDependency>org.junit.jupiter:junit-jupiter</ignoredUnusedDeclaredDependency>
            </ignoredUnusedDeclaredDependencies>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven.enforcer.plugin.version}</version>
        <executions>
          <execution>
            <id>enforce-runtime-dependency-discipline</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <!-- I7 依赖纪律：SDK 运行时只允许 Jackson 家族 / RE2J / JDK -->
                    <exclude>org.springframework*</exclude>
                    <exclude>com.google.guava*</exclude>
                    <exclude>org.projectlombok*</exclude>
                    <exclude>org.hibernate*</exclude>
                    <exclude>org.mybatis*</exclude>
                    <exclude>ch.qos.logback*</exclude>
                    <exclude>org.slf4j*</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      按需模块：Spring Boot starter。
      默认不进 reactor（SDK 优先：非 Spring 宿主不该被拖入 Spring）。
      构建/测试它：./mvnw -Pstarter verify
    -->
    <profile>
      <id>starter</id>
      <modules>
        <module>mos4j-spring-boot-starter</module>
      </modules>
    </profile>

    <!--
      根工程**不再有** `-Pmcp` profile：MCP 客户端接入已并入 `mos4j-tool`（2026-11-08 合并），
      在默认 reactor 里。官方 MCP SDK 在 mos4j-tool 里是 optional：不声明它的宿主不会被传递污染。
      要跑 MCP 示例用 examples 侧的局部 profile：./mvnw -Pexamples,mcp verify
    -->

    <!--
      示例集（默认不激活）：每个示例一个模块。
      示例是给人读的装配说明书，不是交付本体——放进默认 reactor 会稀释
      「一次依赖拿到能跑的智能体」这条承诺。
      构建：./mvnw -Pexamples verify
    -->
    <profile>
      <id>examples</id>
      <modules>
        <module>examples</module>
      </modules>
    </profile>

    <!--
      发布 profile（默认不激活）：源码附件 + javadoc 附件 + GPG 签名。
      激活方式：./mvnw -Prelease -Pstarter deploy（示例与 examples,mcp 两套见 docs/release.md §5）

      为什么单独放 profile：附件与签名只在发布时需要，
      让它们进默认构建只会拖慢每一次本地构建（javadoc 生成尤其慢）。

      为什么不在这里写「发布到 Central」的插件：Sonatype 的发布通道有两条
      （旧的 OSSRH staging 与新的 Central Portal），两条的插件与仓库地址都不一样，
      而本仓库**没有核实过当前该用哪条**——写一个没核实过的插件版本号，
      只会让发布在最后一步失败。所以：附件与签名在这里配好，
      发布通道在 docs/release.md §5 里按当时的官方文档填（见「还缺什么」表）。
    -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.1</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals><goal>jar-no-fork</goal></goals>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.6.3</version>
            <configuration>
              <!-- 文档里的中文与 {@code @code} 片段多，doclint 的严格 HTML 检查会误报；
                   发布前请人扫一眼生成的 javadoc。 -->
              <doclint>none</doclint>
              <charset>UTF-8</charset>
              <docencoding>UTF-8</docencoding>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals><goal>jar</goal></goals>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.4</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <goals><goal>sign</goal></goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!--
      内部私服发布（2026-11-07 裁决：先发内部私服，暂不发 Maven Central）。
      与 `release` profile **正交**：release 管附件与签名，internal-publish 管上传地址。
      两者要一起用：-Prelease,internal-publish deploy
      地址与仓库 id 一律由命令行 -D 注入（见 docs/release.md §5），仓库里不写死环境信息。
      未注入地址 → deploy 失败并报出未解析的属性名（fail-closed），不会误发。
    -->
    <profile>
      <id>internal-publish</id>
      <distributionManagement>
        <repository>
          <id>${mos4j.distribution.releaseRepoId}</id>
          <url>${mos4j.distribution.releaseUrl}</url>
        </repository>
        <snapshotRepository>
          <id>${mos4j.distribution.snapshotRepoId}</id>
          <url>${mos4j.distribution.snapshotUrl}</url>
        </snapshotRepository>
      </distributionManagement>
    </profile>
  </profiles>
</project>
