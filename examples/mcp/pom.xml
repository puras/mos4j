<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>net.hegq</groupId>
    <artifactId>mos4j-examples</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>mos4j-example-mcp</artifactId>
  <name>MoS4J :: Example :: mcp</name>
  <description>MCP 示例：接一台 MCP 服务器</description>
  <dependencies>
    <!-- 门面：缺省模型装配（默认模型走它） -->
    <dependency>
      <groupId>net.hegq</groupId>
      <artifactId>mos4j-agent</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!--
      共享词汇表：McpKit.describeContributor() 的返回类型是 core 的 DescribeContributor，
      编译期就引用了它 —— 直接用到的模块必须直接声明，不靠传递依赖“恰好能编译”。
    -->
    <dependency>
      <groupId>net.hegq</groupId>
      <artifactId>mos4j-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- 工具注册表 + MCP 接入（mos4j-tool）：MCP 工具就是普通工具 -->
    <dependency>
      <groupId>net.hegq</groupId>
      <artifactId>mos4j-tool</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- 会话 -->
    <dependency>
      <groupId>net.hegq</groupId>
      <artifactId>mos4j-session</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- ChatModel -->
    <dependency>
      <groupId>net.hegq</groupId>
      <artifactId>mos4j-model</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!--
      自带的那台 MCP 服务器（EchoMcpServer）直接用官方 SDK 的服务端 API：
      官方 SDK 类型只出现在这个示例模块里，不进 MoS4J 的对外契约。
    -->
    <dependency>
      <groupId>io.modelcontextprotocol.sdk</groupId>
      <artifactId>mcp-json-jackson3</artifactId>
      <version>${mcp.sdk.version}</version>
    </dependency>
    <!-- 官方 SDK 的服务端 API（McpServer / 传输）在 mcp-core -->
    <dependency>
      <groupId>io.modelcontextprotocol.sdk</groupId>
      <artifactId>mcp-core</artifactId>
      <version>${mcp.sdk.version}</version>
    </dependency>
    <!-- 官方 SDK 需要一个 Jackson 3 的 JSON mapper 实现 -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- 示例共用的测试替身（脚本化模型）：让用例不碰网络也能真跑一遍装配 -->
    <dependency>
      <groupId>net.hegq</groupId>
      <artifactId>mos4j-example-testkit</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <!--
            依赖纪律门（I7）：本示例依赖官方 MCP Java SDK，传递依赖里有它硬要的 slf4j-api。
            与 mos4j-tool 同一个口径：门改窄而不是关掉——只放行 org.slf4j*，其余禁令照旧。
          -->
          <execution>
            <id>enforce-runtime-dependency-discipline</id>
            <configuration>
              <rules combine.self="override">
                <bannedDependencies>
                  <excludes>
                    <exclude>org.springframework*</exclude>
                    <exclude>com.google.guava*</exclude>
                    <exclude>org.projectlombok*</exclude>
                    <exclude>org.hibernate*</exclude>
                    <exclude>org.mybatis*</exclude>
                    <exclude>ch.qos.logback*</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
