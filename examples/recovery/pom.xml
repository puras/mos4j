<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>net.hegq</groupId>
    <artifactId>mos4j-examples</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>mos4j-example-recovery</artifactId>
  <name>MoS4J :: Example :: recovery</name>
  <description>恢复示例：中断后派生现场 + 显式续跑</description>
  <dependencies>
    <!-- 门面：会话、日志、续跑入口都在这 -->
    <dependency>
      <groupId>net.hegq</groupId>
      <artifactId>mos4j-agent</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- 续跑选项（driver） -->

    <!-- 会话事件日志（派生读的事实来源） -->
    <dependency>
      <groupId>net.hegq</groupId>
      <artifactId>mos4j-session</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- ChatModel -->
    <dependency>
      <groupId>net.hegq</groupId>
      <artifactId>mos4j-model</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- 示例共用的测试替身（脚本化模型）：让用例不碰网络也能真跑一遍装配 -->
    <dependency>
      <groupId>net.hegq</groupId>
      <artifactId>mos4j-example-testkit</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
