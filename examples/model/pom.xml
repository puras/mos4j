<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>net.hegq</groupId>
    <artifactId>mos4j-examples</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>mos4j-example-model</artifactId>
  <name>MoS4J :: Example :: model</name>
  <description>纯模型示例：直接对接 ChatModel（非流式 / 流式 / 取消），没有工具与会话</description>
  <dependencies>
    <!-- 只要模型层：这就是「模型能力对接」的全部依赖面（core 经它传递） -->
    <dependency>
      <groupId>net.hegq</groupId>
      <artifactId>mos4j-model</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- 示例共用的测试替身（脚本化模型）：让用例不碰网络也能真跑一遍调用面 -->
    <dependency>
      <groupId>net.hegq</groupId>
      <artifactId>mos4j-example-testkit</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
