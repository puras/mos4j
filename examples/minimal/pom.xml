<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>net.hegq</groupId>
    <artifactId>mos4j-examples</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>mos4j-example-minimal</artifactId>
  <name>MoS4J :: Example :: minimal</name>
  <description>最小示例：一次装配，一个问题，一句回答</description>
  <dependencies>
    <!-- 门面：一次依赖拿到能跑的智能体 -->
    <dependency>
      <groupId>net.hegq</groupId>
      <artifactId>mos4j-agent</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- ChatModel（宿主把自己的模型注入进来） -->
    <dependency>
      <groupId>net.hegq</groupId>
      <artifactId>mos4j-model</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- 智能体类型（门面返回 Agent；示例要打印装配快照） -->

    <!-- 示例共用的测试替身（脚本化模型）：让用例不碰网络也能真跑一遍装配 -->
    <dependency>
      <groupId>net.hegq</groupId>
      <artifactId>mos4j-example-testkit</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
