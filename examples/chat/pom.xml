<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>net.hegq</groupId>
    <artifactId>mos4j-examples</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>mos4j-example-chat</artifactId>
  <name>MoS4J :: Example :: chat</name>
  <description>多轮对话示例：会话恢复、审批、守卫、策略</description>
  <dependencies>
    <!-- 门面：一次依赖拿到能跑的智能体 -->
    <dependency>
      <groupId>net.hegq</groupId>
      <artifactId>mos4j-agent</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- ChatModel（宿主把自己的模型注入进来） -->
    <dependency>
      <groupId>net.hegq</groupId>
      <artifactId>mos4j-model</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- 审批请求与结果（core） -->
    <dependency>
      <groupId>net.hegq</groupId>
      <artifactId>mos4j-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- 审批通道与守卫总线（hook） -->
    <dependency>
      <groupId>net.hegq</groupId>
      <artifactId>mos4j-tool</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- 名字级策略（policy） -->

    <!-- 会话事件（用例要读日志里的审批结局） -->
    <dependency>
      <groupId>net.hegq</groupId>
      <artifactId>mos4j-session</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- 示例共用的测试替身（脚本化模型）：让用例不碰网络也能真跑一遍装配 -->
    <dependency>
      <groupId>net.hegq</groupId>
      <artifactId>mos4j-example-testkit</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
