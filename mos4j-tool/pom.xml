<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>net.hegq</groupId>
    <artifactId>mos4j</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>mos4j-tool</artifactId>
  <name>MoS4J :: Tool</name>
  <description>工具族：工具抽象与注册表（注解+反射 Schema，失败 fail-closed）、内置工具、技能（skill）、子代理（subagent）、守卫与审批（hook）、参数级/名字级策略（policy）、MCP 接入（mcp）</description>
  <dependencies>
    <!-- 技能审计接口（SkillAudit）、取消令牌、工具上下文、DescribeContributor 都在 core：显式声明，不靠传递依赖 -->
    <dependency>
      <groupId>net.hegq</groupId>
      <artifactId>mos4j-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>net.hegq</groupId>
      <artifactId>mos4j-model</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- 内置文件工具走 file jail + 写前观察门；shell 工具走沙箱（fs 与 sandbox 现已合为 runtime） -->
    <dependency>
      <groupId>net.hegq</groupId>
      <artifactId>mos4j-runtime</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- grep / glob 的模式来自模型 = 不可信输入：禁用回溯引擎，一律 RE2J -->
    <dependency>
      <groupId>com.google.re2j</groupId>
      <artifactId>re2j</artifactId>
      <version>${re2j.version}</version>
    </dependency>
    <!-- Schema / 参数容错直接用 Jackson（不靠传递依赖） -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
      <version>${jackson.annotations.version}</version>
    </dependency>
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-core</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <!-- 技能 frontmatter 是 YAML：用现成库（Jackson YAML 模块 → SnakeYAML Engine），
         不自创「最小 YAML 子集」——那等于拿技能的元数据解析去赌一个自写的词法器。 -->
    <dependency>
      <groupId>tools.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <!--
      官方 MCP Java SDK：**optional**——不声明它的宿主不会被传递污染
      （它的传递依赖里有 slf4j-api / reactor-core / json-schema-validator）。
      用 MCP 能力的宿主必须自己显式声明这两个构件（见 docs/contract/API.md §3.16）。
      协议层不手写：2026-07-28 规范废弃了 initialize/roots/sampling。
    -->
    <dependency>
      <groupId>io.modelcontextprotocol.sdk</groupId>
      <artifactId>mcp-core</artifactId>
      <version>${mcp.sdk.version}</version>
      <optional>true</optional>
    </dependency>
    <!-- Jackson 3 的 JSON mapper 实现（SDK 需要一个 McpJsonMapper） -->
    <dependency>
      <groupId>io.modelcontextprotocol.sdk</groupId>
      <artifactId>mcp-json-jackson3</artifactId>
      <version>${mcp.sdk.version}</version>
      <optional>true</optional>
    </dependency>
    <!--
      测试作用域：Jetty 只用来起一台**真的** streamable-http MCP 服务器。
      官方 SDK 的服务端传输只有 stdio 与 HttpServlet 两族（无 servlet 容器就没法起 HTTP 服务器），
      所以这里引入一个嵌入式容器——**仅测试**，不进运行时依赖。
      为什么值得：认证用例打的是「真 HTTP + 假服务器」，只能验到传输层；
      这里的用例能验到完整协议链路（会话头、SSE、initialize、tools/list、tools/call）。
    -->
    <dependency>
      <groupId>org.eclipse.jetty.ee10</groupId>
      <artifactId>jetty-ee10-servlet</artifactId>
      <version>12.0.36</version>
      <scope>test</scope>
    </dependency>
    <!-- Jetty 12.1 用 Servlet 6.1；官方 SDK 的 jakarta.servlet-api 是 provided，测试里要显式声明 -->
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <version>6.1.0</version>
      <scope>test</scope>
    </dependency>
    <!-- 测试里直接用 Server / ServerConnector（起嵌入式服务器）→ 显式声明 -->
    <dependency>
      <groupId>org.eclipse.jetty</groupId>
      <artifactId>jetty-server</artifactId>
      <version>12.0.36</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <!--
            依赖纪律门（I7）：SDK 六模块禁 Spring / Guava / ORM / Lombok / Logback / SLF4J。
            本模块是**唯一**允许出现 SLF4J 的地方——官方 MCP SDK 硬依赖 slf4j-api
            （jar 内 199 处引用，排除会直接 NoClassDefFoundError，不是「少个日志门面」的事）。

            这里**不是**把整条门关掉（那等于顺手放开了 Guava / ORM / Lombok / Spring），
            而是把门改窄：只放行 org.slf4j*，其余禁令照旧。
            slf4j-api **只含 API、不含实现** → 没有绑定时是 NOP logger，不产生任何日志输出。
            combine.self="override"：确保父 POM 的规则整块被替换，不与其合并。

            注意（2026-11-08 合并）：MCP 接入从「按需模块 mos4j-mcp」并入本模块，
            所以这条窄化破例从按需模块搬到了默认模块——**I7 条款的例外位置变了**，
            已登记为 SI-52（见 docs/contract/SELF-INVENTED.md）。
          -->
          <execution>
            <id>enforce-runtime-dependency-discipline</id>
            <configuration>
              <rules combine.self="override">
                <bannedDependencies>
                  <excludes>
                    <exclude>org.springframework*</exclude>
                    <exclude>com.google.guava*</exclude>
                    <exclude>org.projectlombok*</exclude>
                    <exclude>org.hibernate*</exclude>
                    <exclude>org.mybatis*</exclude>
                    <exclude>ch.qos.logback*</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
