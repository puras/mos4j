# 构建产物
target/
*.class
*.jar
*.war

# 本地 Maven 仓库（本项目用 -Dmaven.repo.local=.m2repo，沙箱内不能写 ~/.m2）
.m2repo/

# Maven Wrapper 下载的发行版
.mvn/wrapper/maven-wrapper.jar

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project

# 系统与工具产物
.DS_Store
*.log
.gocache/
.tmp/
.mos-trunc/
.mos-shell/

# 本地临时目录：回归日志与一次性修补脚本（不属于交付物）
.j7log/
.j7log2/
.j7log2-*.bak

# 合并旧模块时的临时回收目录（不属于交付物）
.trash/
