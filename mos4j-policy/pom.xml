<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>net.hegq</groupId>
    <artifactId>mos4j</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>mos4j-policy</artifactId>
  <name>MoS4J :: Policy</name>
  <description>安全策略（路径规则、参数规则）；正则一律 RE2J，禁 java.util.regex</description>
  <dependencies>
    <!-- 策略实现 hook 的 Guard 契约（能力层 → 能力层，不成环） -->
    <dependency>
      <groupId>net.hegq</groupId>
      <artifactId>mos4j-hook</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.google.re2j</groupId>
      <artifactId>re2j</artifactId>
    </dependency>
    <!-- 参数策略读不可变载荷快照（直接用 Jackson） -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>
  </dependencies>
</project>
